# Copy to .env and fill in. Never commit the real .env.
VULNSCAN_SECRET_KEY=change-me-to-a-long-random-string
VULNSCAN_ADMIN_PASSWORD=change-me
VULNSCAN_SCAN_INTERVAL_HOURS=6
VULNSCAN_DIGEST_INTERVAL_DAYS=7
VULNSCAN_CONTACT_URL=https://your-company.example/security-monitoring

# Email alerts (any SMTP provider: Gmail app password, Brevo, Amazon SES...)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@your-company.example
SMTP_PASSWORD=
SMTP_FROM=alerts@your-company.example
SMTP_STARTTLS=1

# Telegram alerts: create a bot with @BotFather and paste its token
TELEGRAM_BOT_TOKEN=
